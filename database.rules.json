{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('rooms').child($code).child('meta').child('hostUid').val() === auth.uid",
        "meta": {
          ".write": "auth != null && (!data.exists() ? newData.child('hostUid').val() === auth.uid : data.child('hostUid').val() === auth.uid)"
        },
        "state": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('hostUid').val() === auth.uid"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('rooms').child($code).child('meta').child('hostUid').val() === auth.uid)",
            "name": { ".validate": "newData.isString() && newData.val().length <= 20" }
          }
        },
        "buzz": {
          "$segment": {
            "$uid": { ".write": "auth != null && $uid === auth.uid && !data.exists()" }
          }
        },
        "answer": {
          "$segment": {
            "$uid": {
              ".write": "auth != null && $uid === auth.uid",
              "text": { ".validate": "newData.isString() && newData.val().length <= 200" }
            }
          }
        }
      }
    }
  }
}
