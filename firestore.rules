rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/admin)
        && request.auth.uid in get(/databases/$(database)/documents/config/admin).data.uids;
    }

    function validReport() {
      let d = request.resource.data;
      return d.keys().hasOnly(['question_id', 'reason', 'typed_answer', 'note', 'created_at', 'resolved'])
        && d.keys().hasAll(['question_id', 'reason', 'created_at', 'resolved'])
        && d.question_id is string && d.question_id.size() > 0 && d.question_id.size() <= 100
        && d.reason in ['wrong_answer', 'my_answer_should_count', 'typo', 'outdated', 'other']
        && (!('typed_answer' in d) || (d.typed_answer is string && d.typed_answer.size() <= 200))
        && (!('note' in d) || (d.note is string && d.note.size() <= 500))
        && d.resolved == false
        && d.created_at == request.time;
    }

    match /questions/{id} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow write: if isAdmin();
      match /versions/{versionId} {
        allow read, write: if isAdmin();
      }
    }

    match /reports/{id} {
      allow create: if validReport();
      allow read, update: if isAdmin();
    }

    // Admin allowlist: {uids: ["<firebase uid>"]}. Editable only in the Firebase console.
    match /config/admin {
      allow read: if request.auth != null && request.auth.uid in resource.data.uids;
      allow write: if false;
    }
  }
}
